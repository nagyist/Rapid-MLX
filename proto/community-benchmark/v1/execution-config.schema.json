{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raullenchai/Rapid-MLX/proto/community-benchmark/v1/execution-config.schema.json",
  "title": "Rapid-MLX ExecutionConfig v1",
  "description": "The effective runtime configuration that actually produced a benchmark result. Values are post-default/post-resolution, not merely user-requested options.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_digest",
    "runtime",
    "load",
    "generation",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "config_digest": {
      "$ref": "#/$defs/sha256Digest",
      "description": "RFC 8785 + SHA-256 digest of the effective load, generation, and features objects. Runtime versions are deliberately excluded and remain separate cohort axes. The server recomputes it."
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "rapid_mlx",
        "mlx",
        "python"
      ],
      "properties": {
        "distribution": {
          "type": "string",
          "enum": [
            "release",
            "source"
          ]
        },
        "rapid_mlx": {
          "$ref": "#/$defs/versionString"
        },
        "mlx": {
          "$ref": "#/$defs/versionString"
        },
        "mlx_lm": {
          "$ref": "#/$defs/versionString"
        },
        "mlx_vlm": {
          "$ref": "#/$defs/versionString"
        },
        "python": {
          "$ref": "#/$defs/versionString"
        },
        "rapid_mlx_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "distribution": {
                "const": "source"
              }
            },
            "required": [
              "distribution"
            ]
          },
          "then": {
            "required": [
              "rapid_mlx_revision"
            ]
          },
          "else": {
            "not": {
              "required": [
                "rapid_mlx_revision"
              ]
            }
          }
        }
      ]
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_length",
        "max_concurrent_sequences"
      ],
      "properties": {
        "context_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_concurrent_sequences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "wired_memory_limit_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "ignore_eos"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "min_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "ignore_eos": {
          "type": "boolean"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speculative_decoding",
        "kv_cache",
        "prefix_cache",
        "prefill"
      ],
      "properties": {
        "speculative_decoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "none",
                "mtp",
                "draft_model",
                "dflash",
                "ddtree",
                "dspark",
                "suffix"
              ]
            },
            "max_draft_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "draft_model_identity_digest": {
              "$ref": "#/$defs/sha256Digest"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "none"
                  }
                },
                "required": [
                  "method"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "max_draft_tokens"
                      ]
                    },
                    {
                      "required": [
                        "draft_model_identity_digest"
                      ]
                    }
                  ]
                }
              },
              "else": {
                "required": [
                  "max_draft_tokens"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "method": {
                    "enum": [
                      "draft_model",
                      "dflash",
                      "ddtree",
                      "dspark"
                    ]
                  }
                },
                "required": [
                  "method"
                ]
              },
              "then": {
                "required": [
                  "draft_model_identity_digest"
                ]
              }
            }
          ]
        },
        "kv_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "dtype"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "full_precision",
                "quantized",
                "offloaded"
              ]
            },
            "dtype": {
              "type": "string",
              "enum": [
                "float32",
                "float16",
                "bfloat16",
                "q8",
                "q6",
                "q4",
                "q3",
                "q2",
                "other",
                "unknown"
              ]
            },
            "bits": {
              "type": "number",
              "minimum": 1,
              "maximum": 32,
              "multipleOf": 0.5
            },
            "group_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "offload_target": {
              "type": "string",
              "enum": [
                "memory",
                "disk",
                "hybrid"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "quantized"
                  }
                },
                "required": [
                  "mode"
                ]
              },
                  "then": {
                    "required": [
                      "bits",
                      "group_size"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "offloaded"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "required": [
                      "offload_target"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "offload_target"
                      ]
                    }
                  }
                }
              ]
            },
        "prefix_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storage": {
              "type": "string",
              "enum": [
                "memory",
                "disk",
                "hybrid"
              ]
            }
          },
          "allOf": [
              {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "storage"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "storage"
                    ]
                  }
                }
              }
          ]
        },
        "prefill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "gpu",
                "ane",
                "hybrid",
                "unknown"
              ]
            },
            "chunk_size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "versionString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
    }
  }
}
