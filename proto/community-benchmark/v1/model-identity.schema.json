{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raullenchai/Rapid-MLX/proto/community-benchmark/v1/model-identity.schema.json",
  "title": "Rapid-MLX ModelIdentity v1",
  "description": "Privacy-safe identity for the concrete model artifact used by a benchmark. Display metadata is never a comparison key; local paths are never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_strength",
    "source",
    "artifact",
    "quantization"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "identity_strength": {
      "type": "string",
      "enum": [
        "registry_pinned",
        "repository_revision",
        "local_manifest",
        "unresolved"
      ],
      "description": "How the client resolved this identity. It is evidence for server verification, not a client-authored trust verdict."
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mutable presentation metadata. Every field in this object is excluded from identity and comparison digests.",
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\\\r\\n]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\r\\n]+$"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "description": "Normalized model-family metadata used for discovery, never as sufficient artifact identity.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "parameter_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "huggingface",
            "local"
          ]
        },
        "repo_id": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "resolved_revision": {
          "type": "string",
          "description": "Immutable 40-hex Hugging Face repository commit, never a branch or tag.",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "huggingface"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "repo_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "local"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "repo_id"
                  ]
                },
                {
                  "required": [
                    "resolved_revision"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "mlx-safetensors",
            "safetensors",
            "gguf",
            "other"
          ]
        },
        "manifest_digest": {
          "$ref": "#/$defs/sha256Digest",
          "description": "Digest of the privacy-safe artifact manifest defined by the contract ADR; never a digest of a local path."
        },
        "manifest_basis": {
          "type": "string",
          "enum": [
            "huggingface_tree",
            "content_sha256"
          ],
          "description": "Which normative manifest projection was hashed. Local manifests must use content_sha256."
        },
        "config_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "tokenizer_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "weights",
            "weights_and_activations",
            "mixed",
            "unknown"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "weight_bits": {
          "type": "number",
          "minimum": 1,
          "maximum": 32,
          "multipleOf": 0.5
        },
        "activation_bits": {
          "type": "number",
          "minimum": 1,
          "maximum": 32,
          "multipleOf": 0.5
        },
        "group_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "base_dtype": {
          "type": "string",
          "enum": [
            "float32",
            "float16",
            "bfloat16",
            "other",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "weights",
                  "weights_and_activations"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "method",
              "weight_bits"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "weights_and_activations"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "activation_bits"
            ]
          }
        }
      ]
    },
    "identity_digest": {
      "$ref": "#/$defs/sha256Digest",
      "description": "RFC 8785 + SHA-256 digest of the identity projection defined by the contract ADR. The server recomputes it."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity_strength": {
            "const": "unresolved"
          }
        },
        "required": [
          "identity_strength"
        ]
      },
      "then": {
        "not": {
          "required": [
            "identity_digest"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_strength": {
            "const": "registry_pinned"
          }
        },
        "required": [
          "identity_strength"
        ]
      },
      "then": {
        "required": [
          "identity_digest"
        ],
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "huggingface"
              }
            },
            "required": [
              "kind",
              "repo_id",
              "resolved_revision"
            ]
          },
          "artifact": {
            "required": [
              "format",
              "manifest_digest",
              "manifest_basis"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_strength": {
            "const": "repository_revision"
          }
        },
        "required": [
          "identity_strength"
        ]
      },
      "then": {
        "required": [
          "identity_digest"
        ],
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "huggingface"
              }
            },
            "required": [
              "kind",
              "repo_id",
              "resolved_revision"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_strength": {
            "const": "local_manifest"
          }
        },
        "required": [
          "identity_strength"
        ]
      },
      "then": {
        "required": [
          "identity_digest"
        ],
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "local"
              }
            },
            "required": [
              "kind"
            ]
          },
          "artifact": {
            "required": [
              "format",
              "manifest_digest",
              "manifest_basis"
            ],
            "properties": {
              "manifest_basis": {
                "const": "content_sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
